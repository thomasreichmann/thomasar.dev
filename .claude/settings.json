{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-identity.sh\"",
                        "timeout": 30000
                    },
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-setup.sh\"",
                        "timeout": 600000
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | xargs -I {} npx prettier --write --ignore-unknown {}"
                    }
                ]
            }
        ]
    },
    "attribution": {
        "commit": "",
        "pr": ""
    }
}
